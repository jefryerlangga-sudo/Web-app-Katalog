{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "HP accessories catalog item for PortalTech shoppers and the verified master admin",
      "type": "object",
      "properties": {
        "sku": {
          "type": "string",
          "description": "Stock keeping unit identifier",
          "maxLength": 64
        },
        "name": {
          "type": "string",
          "description": "Product display name",
          "maxLength": 150
        },
        "brand": {
          "type": "string",
          "description": "Brand manufacturer name",
          "maxLength": 80
        },
        "category": {
          "type": "string",
          "description": "Primary product category",
          "maxLength": 80
        },
        "subcategory": {
          "type": "string",
          "description": "Secondary subcategory",
          "maxLength": 80
        },
        "imageUrl": {
          "type": "string",
          "description": "Image URL of the part",
          "maxLength": 500
        },
        "specification": {
          "type": "string",
          "description": "Technical specifications and material details",
          "maxLength": 1000
        },
        "compatibility": {
          "type": "string",
          "description": "Phone and device compatibility",
          "maxLength": 600
        },
        "sellingPoint1": {
          "type": "string",
          "description": "First key sales pitch point",
          "maxLength": 200
        },
        "sellingPoint2": {
          "type": "string",
          "description": "Second key sales pitch point",
          "maxLength": 200
        },
        "sellingPoint3": {
          "type": "string",
          "description": "Third key sales pitch point",
          "maxLength": 200
        },
        "wholesalePrice": {
          "type": "number",
          "description": "Wholesale price stored on the public product document"
        },
        "suggestedRetailPrice": {
          "type": "number",
          "description": "Customer retail price used as the authoritative checkout price"
        },
        "stockStatus": {
          "type": "string",
          "description": "Warehouse availability status",
          "enum": ["In Stock", "Low Stock", "Pre-Order", "Out of Stock"]
        },
        "positioning": {
          "type": "string",
          "description": "Good / Better / Best value tiering",
          "enum": ["Good", "Better", "Best"]
        },
        "targetCustomer": {
          "type": "string",
          "description": "Target retail shop or end-user segment",
          "maxLength": 300
        },
        "isProductFocus": {
          "type": "boolean",
          "description": "Flag for company priority campaign push"
        },
        "isBestSeller": {
          "type": "boolean",
          "description": "Flag for fast-moving high-turnover item"
        },
        "crossSellNotes": {
          "type": "string",
          "description": "Recommended cross-sell products or complementary SKUs",
          "maxLength": 300
        },
        "isActive": {
          "type": "boolean",
          "description": "Whether product is active in catalog"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp of last modification"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp of creation"
        }
      },
      "required": [
        "sku",
        "name",
        "brand",
        "category",
        "subcategory",
        "imageUrl",
        "specification",
        "compatibility",
        "sellingPoint1",
        "sellingPoint2",
        "sellingPoint3",
        "wholesalePrice",
        "suggestedRetailPrice",
        "stockStatus",
        "positioning",
        "targetCustomer",
        "isProductFocus",
        "isBestSeller",
        "crossSellNotes",
        "isActive"
      ]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Signed-in profile. Client writes always use role customer.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "maxLength": 120 },
        "displayName": { "type": "string", "maxLength": 120 },
        "photoURL": { "type": "string", "maxLength": 500 },
        "role": { "type": "string", "enum": ["customer"] },
        "phone": { "type": "string", "maxLength": 32 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "displayName", "photoURL", "role", "phone", "createdAt", "updatedAt"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer checkout order. Totals must match catalog retail prices in Firestore rules.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "customerName": { "type": "string", "maxLength": 120 },
        "customerEmail": { "type": "string", "maxLength": 120 },
        "customerPhone": { "type": "string", "maxLength": 20 },
        "items": { "type": "array" },
        "itemCount": { "type": "number" },
        "subtotal": { "type": "number" },
        "total": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "confirmed", "cancelled", "completed"] },
        "note": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId", "customerName", "customerEmail", "customerPhone",
        "items", "itemCount", "subtotal", "total", "status", "note", "createdAt", "updatedAt"
      ]
    },
    "Admin": {
      "title": "Admin",
      "description": "Legacy allowlist document. Presence does not grant catalog writes.",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "description": "Admin email address",
          "maxLength": 120
        },
        "role": {
          "type": "string",
          "description": "Role name e.g. superadmin",
          "maxLength": 40
        }
      },
      "required": ["email", "role"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "HP accessories catalog. Public read. Verified master admin write."
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Customer profiles. Role cannot be self-elevated."
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Customer-owned orders priced from the catalog."
    },
    "/admins/{adminId}": {
      "schema": "Admin",
      "description": "Legacy documents. Not an authorization grant."
    }
  }
}
