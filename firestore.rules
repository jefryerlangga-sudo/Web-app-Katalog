rules_version = '2';
// Not deployed by git merge. Publish this file from the Firebase console or CLI yourself.
// Catalog writes require the verified master-admin email below.
// Keep that email in sync with MASTER_ADMIN_EMAILS in src/config/app.ts.
// products/{id} is readable only by the verified master admin and must not store wholesalePrice.
// Customers read prices from the private Vercel Blob snapshot via GET /api/catalog, not from Firestore.
// Publish this file only after that app version is deployed and the master admin has synced the Blob.
// Publishing it earlier makes the previous public catalog API fail.
// productAdmin/{id} holds dealer cost and is readable only by the verified master admin.
// analyticsDays/{YYYY-MM-DD} stores visit and click counters. Approved buyers may only
// increment their own visitor slot and known counters by a small step. The master admin reads them.
// Publish this file only after the app version that writes those documents is deployed.
// End-user unit price = ceil(base * 13 / 1000) * 100, computed with integer division.
// That is the same number as ceil(base * 130 / 10000) * 100 in src/config/pricing.ts.
// An order is a header plus one item document per product (orders/{id}/items/0..49).
// Each item checks its own catalog price. Stock is not checked. At most 50 kinds.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function authEmail() {
      return request.auth.token.email is string
        ? request.auth.token.email.lower()
        : '';
    }

    function isVerifiedMasterAdmin() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && authEmail() == 'jefryerlangga@gmail.com';
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isIsoLike(value) {
      return value is string && value.size() >= 10 && value.size() <= 40;
    }

    function isValidProduct(data) {
      return data.keys().hasAll([
        'sku', 'name', 'brand', 'category', 'subcategory', 'imageUrl',
        'specification', 'compatibility', 'sellingPoint1', 'sellingPoint2', 'sellingPoint3',
        'suggestedRetailPrice', 'stockStatus', 'positioning',
        'targetCustomer', 'isProductFocus', 'isBestSeller', 'crossSellNotes', 'isActive'
      ]) &&
      data.keys().hasOnly([
        'sku', 'name', 'brand', 'category', 'subcategory', 'imageUrl',
        'specification', 'compatibility', 'sellingPoint1', 'sellingPoint2', 'sellingPoint3',
        'suggestedRetailPrice', 'stockStatus', 'positioning',
        'targetCustomer', 'isProductFocus', 'isBestSeller', 'crossSellNotes', 'isActive',
        'createdAt', 'updatedAt'
      ]) &&
      !data.keys().hasAny(['wholesalePrice']) &&
      data.sku is string && data.sku.size() > 0 && data.sku.size() <= 64 &&
      data.name is string && data.name.size() > 0 && data.name.size() <= 150 &&
      data.brand is string && data.brand.size() <= 80 &&
      data.category is string && data.category.size() <= 80 &&
      data.subcategory is string && data.subcategory.size() <= 80 &&
      data.imageUrl is string && data.imageUrl.size() <= 500 &&
      data.specification is string && data.specification.size() <= 1000 &&
      data.compatibility is string && data.compatibility.size() <= 600 &&
      data.sellingPoint1 is string && data.sellingPoint1.size() <= 200 &&
      data.sellingPoint2 is string && data.sellingPoint2.size() <= 200 &&
      data.sellingPoint3 is string && data.sellingPoint3.size() <= 200 &&
      data.suggestedRetailPrice is number && data.suggestedRetailPrice >= 0 &&
      data.stockStatus in ['In Stock', 'Low Stock', 'Pre-Order', 'Out of Stock'] &&
      data.positioning in ['Good', 'Better', 'Best'] &&
      data.targetCustomer is string && data.targetCustomer.size() <= 300 &&
      data.isProductFocus is bool &&
      data.isBestSeller is bool &&
      data.crossSellNotes is string && data.crossSellNotes.size() <= 300 &&
      data.isActive is bool &&
      (!data.keys().hasAny(['createdAt']) || isIsoLike(data.createdAt)) &&
      (!data.keys().hasAny(['updatedAt']) || isIsoLike(data.updatedAt));
    }

    function isValidProductAdmin(data) {
      return data.keys().hasOnly(['wholesalePrice', 'updatedAt']) &&
        data.wholesalePrice is number &&
        data.wholesalePrice >= 0 &&
        isIsoLike(data.updatedAt);
    }

    function userProfileShape(data) {
      return data.keys().hasOnly([
          'uid', 'email', 'displayName', 'photoURL', 'role', 'phone', 'createdAt', 'updatedAt'
        ]) &&
        data.uid is string && data.uid.size() > 0 &&
        data.email is string && data.email.size() > 0 && data.email.size() <= 120 &&
        data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 120 &&
        data.photoURL is string && data.photoURL.size() <= 500 &&
        data.phone is string && data.phone.size() <= 32 &&
        isIsoLike(data.createdAt) &&
        isIsoLike(data.updatedAt);
    }

    function isStoredRole(role) {
      return role in ['pending', 'rejected', 'grosir', 'end_user', 'customer'];
    }

    function isPendingSignup(data) {
      return userProfileShape(data) &&
        data.uid == request.auth.uid &&
        data.email.lower() == authEmail() &&
        data.role == 'pending';
    }

    function isSelfProfileUpdate() {
      return userProfileShape(request.resource.data) &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.email.lower() == authEmail() &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.role == resource.data.role &&
        isStoredRole(resource.data.role) &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'email', 'displayName', 'photoURL', 'phone', 'updatedAt'
        ]);
    }

    function isAdminRoleUpdate() {
      return isVerifiedMasterAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'updatedAt']) &&
        request.resource.data.role in ['pending', 'rejected', 'grosir', 'end_user'] &&
        isIsoLike(request.resource.data.updatedAt);
    }

    // ceil(base * 13 / 1000) * 100, integer only.
    // Same value as ceil(base * 130 / 10000) * 100 in src/config/pricing.ts.
    // math.ceil() throws when the quotient is not already a whole number, which
    // rejected end-user checkout for any selling price that is not a multiple of 1000.
    function endUserUnitPrice(base) {
      return (base * 13 + 999) / 1000 * 100;
    }

    function buyerDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isApprovedBuyer() {
      return isVerifiedMasterAdmin() || (
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        buyerDoc().role in ['grosir', 'end_user', 'customer']
      );
    }

    // The header names the products. Each item document checks one catalog price.
    // A single write cannot re-check 20 products: 10 document reads per write,
    // 20 across a batch, and 1,000 expressions per request.
    // Stock is not checked. An empty warehouse is handled by the shop after the order.
    function buyerPaysEndUser() {
      return !isVerifiedMasterAdmin() && buyerDoc().role == 'end_user';
    }

    function isOrderHeader(data) {
      return data.keys().hasOnly([
          'userId', 'customerName', 'customerEmail', 'customerPhone',
          'lineCount', 'productIds', 'itemCount', 'subtotal', 'total',
          'status', 'note', 'createdAt', 'updatedAt'
        ])
        && data.userId == request.auth.uid
        && data.customerEmail is string
        && data.customerEmail.lower() == authEmail()
        && data.customerName is string
        && data.customerName.size() > 0
        && data.customerName.size() <= 120
        && data.customerPhone is string
        && data.customerPhone.size() >= 8
        && data.customerPhone.size() <= 20
        && data.lineCount is int
        && data.lineCount > 0
        && data.lineCount <= 50
        && data.productIds is list
        && data.productIds.size() == data.lineCount
        && data.itemCount is int
        && data.itemCount > 0
        && data.itemCount <= 4950
        && data.subtotal is number
        && data.subtotal >= 0
        && data.total == data.subtotal
        && data.status == 'pending'
        && data.note is string
        && data.note.size() <= 500
        && isIsoLike(data.createdAt)
        && isIsoLike(data.updatedAt)
        && isApprovedBuyer();
    }

    // Slot id is 0..49, so a 51st item document has no legal id.
    function isLineSlot(lineId) {
      return lineId.matches('^([0-9]|[1-4][0-9])$');
    }

    function orderItemOk(orderId, lineId, data) {
      let header = get(/databases/$(database)/documents/orders/$(orderId)).data;
      let product = get(/databases/$(database)/documents/products/$(data.productId)).data;
      let price = buyerPaysEndUser()
        ? endUserUnitPrice(product.suggestedRetailPrice)
        : product.suggestedRetailPrice;
      return isLineSlot(lineId)
        && header.userId == request.auth.uid
        && header.status == 'pending'
        && header.productIds[int(lineId)] == data.productId
        && data.keys().hasOnly(['userId', 'productId', 'sku', 'name', 'unitPrice', 'quantity', 'lineTotal'])
        && data.userId == request.auth.uid
        && data.productId is string
        && product.isActive == true
        && data.sku == product.sku
        && data.name == product.name
        && data.quantity is int
        && data.quantity > 0
        && data.quantity <= 99
        && data.unitPrice == price
        && data.lineTotal == price * data.quantity;
    }

    match /products/{productId} {
      allow get, list: if isVerifiedMasterAdmin();
      allow create, update: if isVerifiedMasterAdmin() && isValidId(productId) && isValidProduct(request.resource.data);
      allow delete: if isVerifiedMasterAdmin() && isValidId(productId);
    }

    match /productAdmin/{productId} {
      allow get, list: if isVerifiedMasterAdmin();
      allow create, update: if isVerifiedMasterAdmin() && isValidId(productId) && isValidProductAdmin(request.resource.data);
      allow delete: if isVerifiedMasterAdmin() && isValidId(productId);
    }

    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isVerifiedMasterAdmin());
      allow list: if isVerifiedMasterAdmin();
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && isPendingSignup(request.resource.data);
      allow update: if isSelfProfileUpdate() || isAdminRoleUpdate();
      allow delete: if isVerifiedMasterAdmin();
    }

    match /orders/{orderId} {
      allow get: if isSignedIn() && (
        resource.data.userId == request.auth.uid || isVerifiedMasterAdmin()
      );
      allow list: if isSignedIn() && (
        isVerifiedMasterAdmin() || resource.data.userId == request.auth.uid
      );
      allow create: if isSignedIn()
        && isValidId(orderId)
        && isOrderHeader(request.resource.data);
      allow update: if isVerifiedMasterAdmin()
        && isValidId(orderId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status in ['pending', 'confirmed', 'cancelled', 'completed']
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.itemCount == resource.data.itemCount
        && request.resource.data.subtotal == resource.data.subtotal
        && request.resource.data.total == resource.data.total
        && request.resource.data.createdAt == resource.data.createdAt
        && (
          !resource.data.keys().hasAny(['items'])
          || request.resource.data.items == resource.data.items
        );
      allow delete: if isVerifiedMasterAdmin();

      match /items/{lineId} {
        allow get: if isSignedIn() && (
          resource.data.userId == request.auth.uid || isVerifiedMasterAdmin()
        );
        allow list: if isVerifiedMasterAdmin()
          || (isSignedIn() && resource.data.userId == request.auth.uid);
        allow create: if isSignedIn()
          && isValidId(orderId)
          && isValidId(lineId)
          && orderItemOk(orderId, lineId, request.resource.data);
        allow update, delete: if isVerifiedMasterAdmin();
      }
    }

    function analyticsRoleOk(role) {
      return isVerifiedMasterAdmin()
        ? role == 'admin'
        : (role is string && role == buyerDoc().role && isStoredRole(role));
    }

    // One document per signed-in user per Jakarta day. Events only grow, at most 8 per write.
    function analyticsHitOk(hitId) {
      let data = request.resource.data;
      let beforeEvents = resource == null ? [] : resource.data.get('events', []);
      let afterEvents = data.get('events', []);
      return hitId == data.date + '_' + request.auth.uid
        && data.date is string
        && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.uid == request.auth.uid
        && data.email is string
        && data.email.size() > 0
        && data.email.size() <= 120
        && data.email.lower() == authEmail()
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 80
        && isIsoLike(data.seen)
        && data.pages is string
        && data.pages.size() <= 80
        && data.pages.matches('^[a-z,]{0,80}$')
        && analyticsRoleOk(data.role)
        && data.keys().size() <= 12
        && afterEvents is list
        && beforeEvents is list
        && afterEvents.size() >= beforeEvents.size()
        && afterEvents.size() <= beforeEvents.size() + 8
        && afterEvents.size() <= 800
        && afterEvents.hasAll(beforeEvents);
    }

    match /analyticsHits/{hitId} {
      allow get, list: if isVerifiedMasterAdmin();
      allow create, update: if isSignedIn() && isApprovedBuyer() && analyticsHitOk(hitId);
      allow delete: if isVerifiedMasterAdmin();
    }

    // Retained collection. A document here does not grant catalog or order writes.
    match /admins/{adminId} {
      allow get, list: if isVerifiedMasterAdmin();
      allow create, update, delete: if isVerifiedMasterAdmin();
    }
  }
}
