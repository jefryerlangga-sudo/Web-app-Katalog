# Server only. Do not prefix with VITE_. The browser bundle must not receive this value.
# Leave empty to use the keyword catalog fallback.
XAI_API_KEY=""

# Current flagship as of the xAI docs (November 2026). Override without a code change.
XAI_MODEL="grok-4.7"

# Optional. Default is the OpenAI-compatible chat completions endpoint.
# XAI_API_BASE_URL="https://api.x.ai/v1/chat/completions"

# APP_URL: public origin of this app when you host it yourself.
APP_URL=""

# Server only. Do not prefix with VITE_. Full JSON of a Firebase service account
# that can read Firestore (Cloud Datastore User). /api/catalog uses it to read
# product prices after security rules stop client reads. Leave empty only while
# those rules are not published yet; the function then uses the public API key.
# FIREBASE_SERVICE_ACCOUNT=""

# VITE_WHATSAPP_NUMBER: Nomor WhatsApp bisnis (hanya digit, kode negara, tanpa +).
# Nilai ini masuk ke client saat build dan bukan secret.
# Kosongkan untuk menonaktifkan tautan. Aplikasi tidak mengirim pesan WhatsApp sendiri.
VITE_WHATSAPP_NUMBER=""
